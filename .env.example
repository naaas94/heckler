# LLM via LiteLLM — default model is OpenAI GPT-4o mini (`openai/gpt-4o-mini` in code).
# Set the API key for your provider (omit to rely on provider SDK / shell env defaults).
OPENAI_API_KEY=your-openai-key-here

# For `anthropic/...` models in HECKLER_LLM_MODEL:
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: override default model (LiteLLM model id, e.g. openai/gpt-4o-mini, anthropic/claude-3-5-haiku-20241022, ollama/llama3.2)
# HECKLER_LLM_MODEL=openai/gpt-4o-mini

# Optional: base URL for Ollama when using `ollama/...` models (v1 env name).
# OLLAMA_API_BASE=http://127.0.0.1:11434

# WHISPER_MODEL=large-v3
# SCORE_THRESHOLD=0.65
# PACING_INTERVAL=12.0
# KOKORO_VOICE=af_sarah
# LOG_DENSITY_FAILURES=false

# SQLite event store (default logs/heckler.db). Non-empty overrides default path.
# HECKLER_DATABASE_PATH=logs/heckler.db

# Persona selection (default: heckler). Maps to prompts/<name>/ directory.
# HECKLER_PERSONA=heckler

# Optional: hosted LLM observability — LiteLLM/provider tooling reads these when set (no-op if unset).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_TRACING=true
# LANGCHAIN_API_KEY=
# LANGSMITH_API_KEY=
